# PostgreSQL 16 (Prisma). Пример: postgresql://user:password@localhost:5432/imbir
DATABASE_URL=

# Auth.js (админка) — сгенерировать: npx auth secret
AUTH_SECRET=
# Публичный адрес сайта для Auth.js. За обратным прокси обязателен: без него
# библиотека определяет адрес сама и ошибается на localhost:3000, после чего
# любое действие в админке разлогинивает. Обычно совпадает с SITE_URL.
AUTH_URL=
AUTH_TRUST_HOST=true

# Ключ AES-256 для одноразового показа кода сертификата (64 hex-символа):
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CODE_ENCRYPTION_KEY=

# Демо-оплата для разработки/тестов (НЕ включать в production)
PAYMENT_MOCK=

# Отключение обязательной 2FA (TOTP) в админке — ТОЛЬКО локальная разработка.
# В production игнорируется (NODE_ENV=production) и не должно ставиться.
ADMIN_2FA_DISABLED=

# Kaspi, основной способ — ссылка на форму сервиса Kaspi. Собирается у нас,
# наружу не ходит, поэтому не зависит от доступности шлюза. Значения берутся
# из ссылки в кабинете Kaspi: kaspi.kz/pay/{SLUG}?service_id={ID}&{ПОЛЕ}=номер
KASPI_PAY_LINK_SLUG=            # напр. PodarochniisertifikatImbir
KASPI_PAY_SERVICE_ID=           # напр. 11079
KASPI_PAY_ORDER_FIELD_ID=       # id поля «номер заказа», напр. 15991

# Kaspi QR через шлюз PayQR (payqr.kz) — запасной способ и источник статуса
# оплаты. Секрета/подписи нет: терминал опознаётся парой machid + terNumber.
KASPI_PAY_MERCHANT_ID=          # machid, напр. IMBIRVEND
KASPI_PAY_TERMINAL=             # terNumber терминала
KASPI_PAYQR_BASE_URL=           # переопределение адреса шлюза; по умолчанию https://payqr.kz

# Мост Kaspi: секрет, которым бэкенд действующего сайта дёргает наши
# /api/kaspi/order/{номер} и .../paid. Пока не задан — мост выключен (503).
# Генерация: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
KASPI_BRIDGE_TOKEN=

# ForteBank — оплата картой на hosted-странице банка. Basic-авторизация,
# креды выдаёт банк (в исходниках заказчика их нет — хранятся в Node-RED).
FORTE_USERNAME=
FORTE_PASSWORD=
FORTE_API_URL=                  # по умолчанию https://api.fortebank.com

# Email (Resend); без ключа письма пишутся в .mail-outbox/ (dev-мок)
RESEND_API_KEY=
MAIL_FROM=
MANAGER_EMAIL=

# Публичный URL сайта (QR-ссылки, ссылки в письмах)
SITE_URL=

# Altegio (Фаза 3) — запись продаж сертификатов в CRM.
# Для полного синка нужны partner_token + user_token + location_id филиалов.
ALTEGIO_PARTNER_TOKEN=
ALTEGIO_USER_TOKEN=
ALTEGIO_API_KEY=
ALTEGIO_CHAIN_ID=205715         # сеть «Имбирь Thai Spa»
# ALTEGIO_TEST=1 — продажи помечаются [ТЕСТ] и вешаются на служебного
# тест-клиента, markAsPaid не вызывается. Для боевого выпуска выставить 0.
ALTEGIO_TEST=1
# ALTEGIO_SYNC=1 — вообще включает запись в CRM; без неё синк не выполняется
ALTEGIO_SYNC=

# Apple Wallet (Фаза 3). Без всех трёх файлов подписи пропуска собираются
# моком в .wallet-outbox/ — структурно верные, но неподписанные.
# Сертификат из исходников заказчика ИСТЁК 23.02.2026 и выписан на подрядчика:
# нужен перевыпуск Pass Type ID в аккаунте Apple Developer «Имбиря».
# WWDR — промежуточный сертификат Apple, без него цепочка подписи не сходится.
APPLE_WALLET_CERT=              # путь к сертификату Pass Type ID (PEM)
APPLE_WALLET_KEY=               # путь к приватному ключу (PEM, без пароля)
APPLE_WALLET_WWDR=              # путь к Apple WWDR (PEM)
APPLE_WALLET_PASS_TYPE_ID=      # по умолчанию pass.kz.imbir.sert
APPLE_WALLET_TEAM_ID=           # по умолчанию 8P2AARWSYR
# Адрес веб-сервиса обновлений. Задавать ТОЛЬКО когда эндпоинты подняты:
# иначе телефон ходит за обновлением в пустоту и бросает попытки.
APPLE_WALLET_WEB_SERVICE=

# Sentry
SENTRY_DSN=
